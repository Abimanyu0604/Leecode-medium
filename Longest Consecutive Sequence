class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:
        if not  nums:
            return 0
        nums.sort()
        maxx=1
        c=1
        for i in range (0,len(nums)-1):
            if((nums[i+1])-nums[i] ==1):
                c=c+1
            elif nums[i+1] == nums[i]:
                continue
            else:
                maxx=max(c,maxx)
                c=1
        return max(maxx,c)
